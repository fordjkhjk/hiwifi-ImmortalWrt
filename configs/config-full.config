#
# 档位 B / full —— 完整版，用于 Breed 首刷之后在系统内 sysupgrade 升级
#
# 目标: HiWiFi HC5962 极路由4增强版 (MT7621, 128MB NAND, 256MB RAM)
#
# 体积说明（重要，别再被 32MB 误导）:
#   - IMAGE_SIZE = 32768k 只作用于 factory.bin（它的 recipe 带 check-size）
#   - sysupgrade.bin 的 recipe 来自 Device/nand，没有 check-size，编译期不校验
#   - 真实物理上限是 DTS 里 mtd-concat 拼出的 ubi 分区，约 121.75MB
#   - 所以本档位只产出 sysupgrade.bin（diy-part2.sh 会把 factory.bin 摘掉）
#
# 本档位 = minimal 全部内容 + ssr+（Xray + SS + SSR + 分流）+ AdGuard Home
#         + ZeroTier 虚拟组网 + vlmcsd (KMS)
#
# 协议策略: 稳妥优先。
#   只保留 Xray / SS / SSR 三套主力 + 分流组件，这跟 LEDE 内置 ssr+ 的常规
#   水平相当，覆盖市面上绝大多数机场节点。
#   冷门协议（Trojan 独立客户端、obfs、v2ray-plugin、Hysteria、Redsocks2、
#   DNSProxy）默认全部关闭，需要时在下方对应位置取消注释即可。
#
# 预估体积: ~31 MB（ubi 分区 121MB，余量充足）
#

# ===== 目标机型 =====
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_hiwifi_hc5962=y

# ===== LuCI 与中文 =====
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ===== USB 支持 =====
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y

# ===== 文件系统支持 =====
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-msdos=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y

# ===== 自动挂载 =====
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_badblocks=y

# ===== SMB: ksmbd =====
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_kmod-fs-ksmbd=y
# Windows 网络发现（让"网上邻居"/"网络"里能直接看到路由器，约 100KB）
CONFIG_PACKAGE_wsdd2=y


# ===== ssr+ (来自 fw876/helloworld) =====
# 本档位是 sysupgrade.bin，编译期不受 IMAGE_SIZE 限制（详见 README），
# 所以协议栈按「mipsel 能跑的都开」来配。
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn=y

# 透明代理后端: 选 iptables（ssr+ 的 ipset 分流方案）。
# 注意：这与防火墙后端无关——23.05 默认就是 firewall4 + nftables，
# 早期"主动切成 firewall3"的尝试实测被 defconfig 静默推翻（见下方防火墙段落），
# 固件里实际是 fw4。ssr+ 的 iptables 透明代理在 fw4 下照常工作（用的还是
# iptables 命令行 + ipset），两者不冲突。
CONFIG_PACKAGE_luci-app-ssr-plus_Iptables_Transparent_Proxy=y

# ---- 核心引擎（三选一: Xray / V2ray / None）----
# Xray 一个就覆盖 VLESS / VMess / Trojan / Shadowsocks / Reality，
# 含 XTLS、gRPC、WebSocket、HTTP/2 全套传输，是目前机场节点的通用解
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y

# ---- 客户端协议栈 ----
# 就这两套，跟 LEDE 内置 ssr+ 的常规水平一致，覆盖 SS / SSR 全部节点
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client=y   # SS
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=y  # SSR（Makefile 默认 y，显式写上防上游改默认值）
# 服务端一律不要
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server=y

# ---- 分流与 DNS ----
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=y                 # 国内外分流，ssr+ 的看家功能
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_DNS2SOCKS=y                   # Makefile 默认 y，体积极小
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_IPT2Socks=y                   # Xray 透明代理链路要用

# ---- 以下按需开启，默认全关 ----
# 关掉的理由：要么 Xray 已经原生支持、要么属于过时方案、要么是 Go 程序在 mipsel 上有兼容风险。
# 真用得上再单独打开，一次只开一个，方便定位问题。
#
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=y
#     Xray 已原生支持 Trojan 协议，单独装 trojan 客户端属于冗余。
#     只有遇到「Xray 连不上但 trojan 客户端能连」的老节点时才需要。
#
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Simple_Obfs=y
#     老式 obfs 混淆，现基本被 WebSocket+TLS 取代。仅老 SS 节点需要。
#
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_V2ray_Plugin=y
#     Xray 已原生支持 WebSocket 传输，仅老版 SS 节点的 v2ray-plugin 需要。
#
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Hysteria=y
#     Hysteria2 是 Go 写的，mipsel 上体积约 3MB 且兼容性风险最高。
#     除非你的机场明确提供 Hysteria2 节点，否则别开。
#
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Redsocks2=y
#     全局 TCP 转发，特殊场景才用得上，常规翻墙不需要。
#
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_DNSPROXY=y
#     与 ChinaDNS-NG 功能重叠，二选一即可。

# ---- 以下 4 项在 MT7621(mipsel) 上开不了，别动 ----
#   Tuic_Client   depends on aarch64||arm||i386||x86_64
#   Shadow_TLS    depends on aarch64||arm||x86_64
#   NaiveProxy    depends on !(arc||armeb||mips||mips64||powerpc||...)
#   Kcptun        依赖 kcptun-client，但 helloworld 源里没有这个包（开了编译必挂）
#   MosDNS        这是 ssr+「捆绑」的 MosDNS（会 bind 5335 与 AGH 抢端口），不开；
#                 分流用官方源里的独立包 mosdns（见下方「mosdns 分流器」段），两者不同

# ---- 依赖包: 显式列出来确保内置进固件，而不是被编成 ipk ----
# dnsmasq_full_ipset 只是特性开关，必须同时显式选中 dnsmasq-full 这个包本身
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_shadowsocks-libev-ss-local=y
CONFIG_PACKAGE_shadowsocks-libev-ss-redir=y
CONFIG_PACKAGE_shadowsocks-libev-ss-rules=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-check=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_microsocks=y
CONFIG_PACKAGE_dns2tcp=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_jq=y
# 上面若开了哪个可选协议，把对应包也一并打开（对照 README 的协议矩阵表）：
# CONFIG_PACKAGE_simple-obfs-client=y
# CONFIG_PACKAGE_v2ray-plugin=y
# CONFIG_PACKAGE_trojan=y
# CONFIG_PACKAGE_hysteria=y
# CONFIG_PACKAGE_redsocks2=y
# CONFIG_PACKAGE_dnsproxy=y

# ===== AdGuard Home =====
# 核心来自官方 packages 源；LuCI 界面由 diy-part1.sh 直接 clone 进 package/
# 的社区版提供（zh-cn 中文界面已内置在该包里，无需单独的 i18n 包）
# 默认运行：files/etc/AdGuardHome.yaml 烘焙了「上游=127.0.0.1:5353」等关键项，
#   files/etc/uci-defaults/99-dns-setup 首启把 enabled 置 1。全新刷机即自动跑起来。
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y

# ===== mosdns 分流器 =====
# 官方 packages 源 net/mosdns（v5.3.3，Go 程序）。当 AGH 的下游分流器：
#   dnsmasq:53 → AdGuard Home:5335 → mosdns:5353 → 国内外分流
# 国内域名直连国内 DNS（5 家并行），国外域名走 socks5 隧道查 8.8.8.8、失败兜底直连。
# 配置与域名列表在 files/etc/mosdns/（config.yaml + cn.txt）：
#   - v5.3.3 已移除 data_providers/servers 顶层键，也不支持 geosite.dat 二进制，
#     故用 domain_set 加载纯文本列表 cn.txt（源自 felixonmars/dnsmasq-china-list），
#     无需 v2ray-geosite 数据包。
#   - config.yaml 已用官方 v5.3.3 Windows 二进制实跑验证：加载成功、国内外分流正确。
# 注意：ssr+ 的 DNS 模式仍选 0（本机 5335，字段 pdnsd_enable 默认即 0）；装了 mosdns
# 包后 ssr+ 界面会多出「Use MosDNS query（值 4）」，那是让 ssr+ 自己托管 mosdns 抢 5335，别选。
CONFIG_PACKAGE_mosdns=y

# ===== ZeroTier 虚拟组网 =====
# 全部来自官方 packages 源，mipsel 可用。本体约 500KB，含依赖合计约 1MB
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y
CONFIG_PACKAGE_zerotier=y
# 依赖: kmod-tun 是 TUN/TAP 虚拟网卡，zerotier 靠它建虚拟网口。
# 下面这几项虽然会被依赖关系自动选上，但仍显式写成 =y ——
# 否则它们只会以依赖身份被编成 ipk 放进软件源，不会内置进固件本体。
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_libstdcpp6=y
CONFIG_PACKAGE_libatomic1=y
CONFIG_PACKAGE_libminiupnpc=y
CONFIG_PACKAGE_libnatpmp1=y

# ===== vlmcsd (KMS 服务) =====
# 官方 packages 源，本体仅 23KB。用于局域网内 Windows / Office 的 KMS 激活
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_vlmcsd=y

# ===== 防火墙: 以默认的 firewall4 (nftables) 为准 =====
#
# 【实测结论】ImmortalWrt 23.05 的默认防火墙是 firewall4 + nftables，证据在
#   include/target.mk 第 55 行起：
#       DEFAULT_PACKAGES.router:= dnsmasq-full firewall4 nftables kmod-nft-offload ...
#   DEVICE_TYPE 默认 router（第 10 行），所以 ramips/mt7621 默认就带 firewall4。
#
# 早期版本这里试图"显式切回 firewall3"，实测不成立：
#   - `CONFIG_PACKAGE_firewall=y` 被 defconfig 降级为 `=m`（模块，不进固件）
#   - `# CONFIG_PACKAGE_firewall4 is not set` 压不过 DEFAULT_PACKAGES.router
#   - 2125 buildinfo 实测：fw3 没进固件、fw4 在固件里
# 结论：不要跟 DEFAULT_PACKAGES 抢，自定义 NAT 用 uci 的 zone masq
#   （zz-hc5962-custom 首启置 lan zone masq=1），不写任何 nft 文件。
#
# LuCI 防火墙管理页（fw4 的前端，要保留）
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
#
# iptables-zz-legacy 等仍保留：ssr+ 的透明代理（ipset 分流）依赖 iptables
# 命令行工具，与 fw4 并存无冲突。
# iptables 是虚拟包名：iptables-zz-legacy 与 iptables-nft 都 PROVIDES:=iptables，
# 直写 CONFIG_PACKAGE_iptables=y 有歧义，这里显式指定 legacy 版，与 ssr+ 的选择一致
CONFIG_PACKAGE_iptables-zz-legacy=y
CONFIG_PACKAGE_ip6tables-zz-legacy=y
CONFIG_PACKAGE_iptables-mod-nat-extra=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-iprange=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
# 软件流量卸载（flow offloading）的 iptables 版内核模块，fw4 的 flowtable 用不到它，
# 保留是因为 ssr+ ipset 链路的连接跟踪卸载仍可能走它（体积约 6KB，无害）
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_ip-full=y

# ===== 维护工具 =====
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
# LuCI 自定义命令按钮：固件升级脚本 fw-check-update / fw-upgrade 的网页入口
# （LuCI → 系统 → 自定义命令），纯官方源，仅依赖 libc，约 6KB
CONFIG_PACKAGE_luci-app-commands=y
# 网页固件升级页（LuCI → 系统 → 固件升级）：检查新版本 + 确认词闸门一键刷入
# 本地包，见 package/luci-app-hc5962-upgrade/
CONFIG_PACKAGE_luci-app-hc5962-upgrade=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y
