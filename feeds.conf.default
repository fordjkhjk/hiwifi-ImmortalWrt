# ImmortalWrt 官方 4 个源（openwrt-23.05 分支）
src-git packages https://github.com/immortalwrt/packages.git;openwrt-23.05
src-git luci https://github.com/immortalwrt/luci.git;openwrt-23.05
src-git routing https://github.com/openwrt/routing.git;openwrt-23.05
src-git telephony https://github.com/openwrt/telephony.git;openwrt-23.05

# ssr+ (官方 ImmortalWrt 源里没有，用上游 fw876/helloworld)
src-git helloworld https://github.com/fw876/helloworld;master

# iStore 软件商店（官方推荐写法，来自 linkease/istore README）
src-git istore https://github.com/linkease/istore;main

# AdGuard Home 的 LuCI 界面
# 注意：immortalwrt/luci 的 openwrt-23.05 分支没有 luci-app-adguardhome，
# 只有 master 分支有，因此这里用社区维护的独立源（AdGuardHome 核心本身
# 仍来自官方 packages 源的 net/adguardhome）
src-git adguardhome https://github.com/rufengsuixing/luci-app-adguardhome;master
