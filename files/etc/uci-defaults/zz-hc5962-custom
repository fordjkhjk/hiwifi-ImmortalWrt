#!/bin/sh
#
# 极路由4增强版 HC5962 旁路由定制脚本
#
# 位置: files/etc/uci-defaults/zz-hc5962-custom
# 执行时机: 首次启动（overlay 为空）时，由 /etc/init.d/boot 调用，
#           在 config_generate 生成默认配置之后执行，因此这里的值就是最终值。
# 约定: 脚本必须以 exit 0 结束，否则系统认为失败，不会删除该脚本。
#
# 需求映射:
#   - 固件 IP      : 192.168.112.200
#   - 网关         : 192.168.112.1
#   - DNS          : 127.0.0.1（路由器自己走本机 DNS 链，见下方说明）
#   - 关闭 IPv4 DHCP 与 IPv6 的 RA / DHCPv6
#   - 防火墙 NAT 回程规则
#   - 每周三 04:00 定时重启
#   - 每 5 分钟健康采样（崩溃取证）
#

# ------------------------------------------------------------------
# 1. LAN 接口: IP / 网关 / DNS
#
# 注意（2026-09-06 修正）：这里原来是 114.114.114.114，会把
# files/etc/uci-defaults/99-dns-setup 设的 127.0.0.1 覆盖掉——
# uci-defaults 按文件名字母序执行，"99-" 在 "zz-" 之前，后者最后生效。
# 路由器本机若用 114 问 DNS，会被污染，导致 ssr+ 网页的「谷歌连通性检查」
# 拿假 IP 去连，永远误报「连接错误」。这里必须保持 127.0.0.1。
# ------------------------------------------------------------------
uci -q batch <<'EOF'
set network.lan.ipaddr='192.168.112.200'
set network.lan.netmask='255.255.255.0'
set network.lan.gateway='192.168.112.1'
set network.lan.dns='127.0.0.1'
set network.lan.delegate='0'
commit network
EOF

# ------------------------------------------------------------------
# 2. 关闭 IPv6（接口层面）
# ------------------------------------------------------------------
uci -q batch <<'EOF'
set network.lan.ipv6='0'
set network.wan.ipv6='0'
set network.wan6.disabled='1'
commit network
EOF

# ------------------------------------------------------------------
# 3. 关闭 IPv4 DHCP + IPv6 的 RA / DHCPv6 / NDP
# ------------------------------------------------------------------
uci -q batch <<'EOF'
set dhcp.lan.ignore='1'
set dhcp.lan.dhcpv6='disabled'
set dhcp.lan.ra='disabled'
set dhcp.lan.ndp='disabled'
set dhcp.lan.ra_slaac='0'
set dhcp.lan.ra_management='0'
set dhcp.lan.ra_flags='none'
commit dhcp
EOF

# 彻底停掉 odhcpd（既然 IPv6 全关）
if [ -x /etc/init.d/odhcpd ]; then
    /etc/init.d/odhcpd stop 2>/dev/null
    /etc/init.d/odhcpd disable 2>/dev/null
fi

# ------------------------------------------------------------------
# 4. 防火墙: 旁路由 NAT 回程（lan zone 开 masq）
#
# 教训（2026-09-05 实机排障确认）：曾在 files/etc/nftables.d/ 放
# `table ip nat { chain ... masquerade }`，但 fw4 是把 /etc/nftables.d/*.nft
# include 进自己的 `table inet fw4 { ... }` 内部——table 里再声明 table
# = nft 语法错，导致整个 fw4 ruleset 渲染失败（防火墙裸奔：无 NAT、无转发
# 规则，「网关指向旁路由 = 上不了网」）。
# 正确姿势：lan zone 置 masq=1，fw4 自动生成 fullcone srcnat，
# 不需要任何手写 nft 文件。
# ------------------------------------------------------------------
i=0
while uci -q get firewall.@zone[$i] >/dev/null 2>&1; do
    if [ "$(uci -q get firewall.@zone[$i].name)" = "lan" ]; then
        uci set firewall.@zone[$i].masq='1'
        uci commit firewall
        break
    fi
    i=$((i+1))
done

# 清理旧 fw3 残留（fw4 不执行 firewall.user；防止旧固件 sysupgrade 带过来）
rm -f /etc/firewall.user

# ------------------------------------------------------------------
# 5. 主机名与时区
# ------------------------------------------------------------------
uci -q batch <<'EOF'
set system.@system[0].hostname='HC5962'
set system.@system[0].timezone='CST-8'
set system.@system[0].zonename='Asia/Shanghai'
commit system
EOF

# ------------------------------------------------------------------
# 6. DNSMASQ: 不对外提供 DHCP，仅保留本地 DNS 解析
# ------------------------------------------------------------------
uci -q batch <<'EOF'
set dhcp.@dnsmasq[0].rebind_protection='0'
commit dhcp
EOF

# ------------------------------------------------------------------
# 7. LuCI 自定义命令: 「检查固件更新」按钮
#    luci-app-commands 读取 /etc/config/luci 里的 command 段。
#    效果: LuCI → 系统 → 自定义命令 页面里出现「检查固件更新」，
#          点击即在网页上看 fw-check-update 的输出（只读，不刷机）。
#    注意: 只挂检查不挂升级。升级脚本 fw-upgrade 需要人工确认，
#          必须在 SSH 终端里跑，不能做成网页一键刷机。
# ------------------------------------------------------------------
# 依赖的包在 minimal 档位里没有（minimal 不含 jq），先判断再添加
if [ -x /usr/bin/fw-check-update ] && command -v jq >/dev/null 2>&1; then
    uci -q batch <<'EOF'
add luci command
set luci.@command[-1].name='检查固件更新'
set luci.@command[-1].command='fw-check-update'
commit luci
EOF
fi

# ------------------------------------------------------------------
# 8. ZeroTier 虚拟网卡登记（配合 ksmbd 接口绑定）
#
# 背景（2026-09-05 实机排障）：ksmbd init 只认 uci network 里登记过的
# 接口段来解析设备名。这里创建一个 proto=none（unmanaged）的接口段，
# 仅用于把名字 zerotier 映射到 ZT 虚拟网卡 ztuze4o5om——netifd 不参与
# 寻址，地址仍由 zerotier 自己管理。
#
# 注意：zt 网卡名由「网络 ID」派生（当前 ID 9f77fc393e3b4cf2 →
# ztuze4o5om）。若以后在 LuCI 里换了网络 ID，网卡名会变，需同步改
# 这里和 files/etc/config/ksmbd 里的引用（改完 /etc/init.d/ksmbd restart）。
# ZT 未配置/未入网时本段无副作用；配合 etc/hotplug.d/net/60-ksmbd-zerotier
# 解决 ksmbd 先于 zerotier 启动的时序问题。
# ------------------------------------------------------------------
if [ -x /etc/init.d/zerotier ] && ! uci -q get network.zerotier >/dev/null 2>&1; then
    uci -q batch <<'EOF'
set network.zerotier=interface
set network.zerotier.proto='none'
set network.zerotier.device='ztuze4o5om'
commit network
EOF
fi

# ------------------------------------------------------------------
# 9. 定时重启：每周三 04:00
#
# 目的：本机内存 244MB，常驻 AdGuard Home + mosdns + xray + ZeroTier，
# 可用内存长期在 30~40MB。每周重启一次清理碎片、释放被长期占用的缓存。
#
# 写法要点：
#   `0 4 * * 3`          周三 04:00，与 ssr+ 订阅更新（每天 02:00）错开 2 小时
#   `sleep 70`           避开整点任务扎堆
#   `touch /etc/banner`  banner 在 overlay（持久区），重启后时间戳保留，
#                        随时可用 `ls -l /etc/banner` 查上次重启时间
#   `/sbin/reboot`       绝对路径：cron 执行时的 PATH 与登录时不同，
#                        写绝对路径可避免「命令找不到」导致任务静默失败
#
# 副作用：AGH 过滤规则存在 /var（内存盘），重启后丢失并重新下载
# （约 4.3MB，耗时可能较长），重启当天上午去广告可能有空窗期。
# ------------------------------------------------------------------
CRON_LINE='0 4 * * 3 sleep 70 && touch /etc/banner && /sbin/reboot'
mkdir -p /etc/crontabs
if ! grep -qF 'touch /etc/banner' /etc/crontabs/root 2>/dev/null; then
    echo "$CRON_LINE" >> /etc/crontabs/root
    chmod 600 /etc/crontabs/root
    /etc/init.d/cron enable 2>/dev/null
fi

# ------------------------------------------------------------------
# 10. 健康采样：每 5 分钟记录负载 / 可用内存 / RSS 前 3 进程
#
# 目的（2026-09-06 实机事故）：本机曾发生「可用内存耗尽 → 内核强制回收
# → UBI 闪存 I/O 阻塞（大量 kworker 卡 D 状态）→ 全机假死」，负载飙到
# 31、SSH / LuCI / 翻墙全断，只能强制重启。而 syslog、dmesg、AGH 查询
# 日志全在内存盘，重启即清空；本机也没有 /sys/fs/pstore。结果是每次
# 崩溃都拿不到现场，无法定性是谁吃掉了内存。
#
# 因此常驻一个轻量采样，把趋势留在 /tmp/health.log，下次崩溃前能看出
# 可用内存是怎么一步步掉下去的，从而定位泄漏源。
#
# 写法要点：
#   */5 * * * *          5 分钟一次，够密；开销可忽略（几百毫秒）
#   日志名不含 ssrplus.log
#                        ssr+ 的 add_cron 用 `sed -i '/ssrplus.log/d'`
#                        清理自己的任务，行里若有该字样会被它误删。
#                        取名 health_sample 可避开。
#   chmod 600            crond 要求属主文件权限正确，否则整份 crontab 不执行
#
# 查看方式：`tail -30 /tmp/health.log`（重启后从空开始，属正常）
# ------------------------------------------------------------------
if [ -x /etc/health_sample.sh ]; then
    if ! grep -qF 'health_sample' /etc/crontabs/root 2>/dev/null; then
        echo '*/5 * * * * /etc/health_sample.sh' >> /etc/crontabs/root
        chmod 600 /etc/crontabs/root
    fi
    /etc/init.d/cron enable 2>/dev/null
fi

exit 0
