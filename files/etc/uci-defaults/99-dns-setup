#!/bin/sh
#
# DNS 链路首启固化脚本
#
# 位置: files/etc/uci-defaults/99-dns-setup
# 执行时机: 首次启动（overlay 为空）时执行一次，exit 0 后自动删除。
#
# 作用: 固化「dnsmasq:53 → AdGuard Home:5335 → mosdns:5353」这条链：
#   1. dnsmasq 转发到 AGH（127.0.0.1#5335），并关闭 resolvfile（noresolv）
#      否则 dnsmasq 会读 /tmp/resolv.conf 的上游，绕过 AGH。
#   2. 启用 AdGuard Home（官方包默认 enabled=0，需置 1）。
#   （mosdns 无需处理：官方包 init 无开关，固件编译时已被统一 enable，
#     开机即随正确配置启动。ssr+ 的 DNS 模式字段 pdnsd_enable 默认即 0 =
#     使用本机 5335，也无需处理。）

# 1. dnsmasq：转发到 AdGuard Home，并停止读 /tmp/resolv.conf 的上游
uci -q batch <<'EOF'
delete dhcp.@dnsmasq[0].server
add_list dhcp.@dnsmasq[0].server='127.0.0.1#5335'
set dhcp.@dnsmasq[0].noresolv='1'
commit dhcp
EOF

# 2. AdGuard Home：写入标准 uci 配置并启用。
#    注意大小写：init 脚本和 uci 都是 `AdGuardHome`（luci-app-adguardhome 的
#    /etc/init.d/AdGuardHome 只读 /etc/config/AdGuardHome，小写版没人读）。
#    官方包默认 enabled=0，须置 1。各字段对齐实机验证值：
#    configpath 指向固件烘焙的 /etc/AdGuardHome.yaml（大写，同款原因）。
uci -q batch <<'EOF'
set AdGuardHome.AdGuardHome.enabled='1'
set AdGuardHome.AdGuardHome.binpath='/usr/bin/AdGuardHome'
set AdGuardHome.AdGuardHome.configpath='/etc/AdGuardHome.yaml'
set AdGuardHome.AdGuardHome.workdir='/var/adguardhome'
set AdGuardHome.AdGuardHome.httpport='3000'
set AdGuardHome.AdGuardHome.redirect='none'
set AdGuardHome.AdGuardHome.logfile='/tmp/AdGuardHome.log'
set AdGuardHome.AdGuardHome.verbose='0'
commit AdGuardHome
EOF

# 3. 让 dnsmasq 新配置生效，并登记 AGH 开机自启（init 名同为大写）
/etc/init.d/dnsmasq restart 2>/dev/null
/etc/init.d/AdGuardHome enable 2>/dev/null

# 4. 路由器本机 DNS 指向本机链（2026-09-05 实机验证）。
#    路由器自己的进程（ssr+ 网页谷歌检查 /usr/bin/ssr-check、opkg 等）
#    默认用上游/ISP DNS，被污染后拿到假 IP → 谷歌检查永远误报「连接错误」。
#    改问 127.0.0.1 即与客户端走同一条 dnsmasq→AGH→mosdns 链。
#    只影响路由器本机工具，不影响电脑手机（它们直接问 dnsmasq:53）。
uci set network.lan.dns='127.0.0.1'
uci commit network

exit 0
