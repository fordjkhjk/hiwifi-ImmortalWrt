# ksmbd（内核态 SMB3 文件共享）配置
#
# 由 luci-app-ksmbd 的 /etc/init.d/ksmbd 读取，编译时统一 enable。
# share 段配合 automount（U 盘热插拔自动挂载）：全新刷机后插 U 盘即自动
# 挂到 /mnt/sda1 并以访客可读写方式共享，无需进界面配置。
# 换 U 盘后若设备名不是 sda1（如 sdb1），在 LuCI 网络共享页改一下路径即可。
#
# interface 列表 = lan + zerotier：让 samba 同时监听 LAN 和 ZeroTier
# 虚拟网卡，外网 ZT 设备才能访问共享（2026-09-05 实机排障确认：默认只绑
# br-lan，ZT 访问 445 直接 Connection refused）。
# 依赖：network 里要有名为 zerotier 的接口段（zz-hc5962-custom 第 8 节
# 创建，其 device 由 ZeroTier 按网络 ID 派生；换网络 ID 后网卡名会变，
# 需同步更新那一处的 device 值——本文件用的是逻辑接口名，不用改），
# 配套 hotplug 脚本 etc/hotplug.d/net/60-ksmbd-zerotier 解决开机时序。
#
# 2026-09-05 从实机验证配置固化。
#
# 2026-09-27 新增 allow_guest_ipc：ksmbd-tools 3.5.6 起移除了 IPC$ 共享默认的
# guest_ok=yes（openwrt/packages commit 0875537），而 Windows 访问任何共享前
# 必须先 tree connect IPC$，被拒即报「访问被拒绝」⇒ 匿名共享（guest_ok=yes）
# 整体失效。故显式开启。配套 uci-defaults/zz-hc5962-custom 第 11 节双保险
# （sysupgrade 保留配置时，本文件不会覆盖实机已有的 /etc/config/ksmbd）。

config globals
	option workgroup 'WORKGROUP'
	option description 'Ksmbd on OpenWrt'
	option interface 'lan zerotier'
	option allow_guest_ipc '1'

config share
	option name 'sda1'
	option path '/mnt/sda1'
	option browseable 'yes'
	option read_only 'no'
	option guest_ok 'yes'
	option create_mask '0666'
	option dir_mask '0777'
